<?xml version="1.0" encoding="utf-8"?>
<!--
  EPIC ШАШКИ — Android shell.
  Built without Gradle by tools/build-apk.sh (aapt v1 + javac + dx + zipalign + apksigner).
  The whole game is an offline web app served from assets/www through MainActivity's
  WebViewClient.shouldInterceptRequest at https://appassets.androidplatform.net/ .
  No INTERNET permission: intercepted requests never touch the network stack.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.epicbadass.checkers"
    android:versionCode="3"
    android:versionName="1.2.0"
    android:installLocation="auto">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- Haptics for moves / captures / combos. The only permission the game needs. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- WebGL (PixiJS) needs OpenGL ES 2.0. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- Android 11+ package visibility: lets TextToSpeech find the installed TTS engine
         (EPIC mode announcer: "COMBO!", "K.O.!"). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/EpicTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorPortrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustPan|stateHidden"
            android:hardwareAccelerated="true"
            android:theme="@style/EpicTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
